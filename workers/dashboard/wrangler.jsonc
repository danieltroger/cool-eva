{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // #318's stable origin: https://cool-eva-dashboard.cool-eva.workers.dev (no path or trailing slash).
  "name": "cool-eva-dashboard",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "assets": { "directory": "../../public", "not_found_handling": "none" },
}
