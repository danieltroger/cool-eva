.DS_Store

# --- Local-only material. This is a PUBLIC repo; keep it that way. ----------
# The local-material paths below carry no trailing slash: any of them may be a
# symlink to iCloud or an external disk on some machine, and `foo/` does not
# match a symlink named foo (git records one as a blob, never a tree). See
# node_modules. `.idea/` at the end of the block is an ordinary editor
# directory and keeps its slash.
#
# Energica's OEM manuals are copyrighted and must never be committed here.
# They live in iCloud; `manuals` is a symlink to that folder.
manuals
Energica_Manuals

# Reverse-engineering toolkit, notes and captured logs: local only.
# (Self-contained: scripts + venv + logs all resolve relative to this folder.)
obd-garage

# Editor / IDE
.idea/
# ---------------------------------------------------------------------------

# Trailing-glob, not exact-match: plain `temperatures.db` did not cover
# suffixed copies such as temperatures.db.bak-flagfix (479 MB).
temperatures.db*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
# No trailing slash: `node_modules/` matches a directory but NOT a symlink of
# that name, and a symlinked node_modules did get committed that way once. Same
# trap the temperatures.db* note above describes.
node_modules
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Ride-log encryption. The private key is the ONLY thing that can read the
# sealed logs — it must never leave the laptop, and never reach the repo or the
# Pi. The public key is cryptographically safe to publish, but it is specific to
# one laptop and this is a public repo, so keep both out.
*.private.pem
*.public.pem
ride-log-key.private.pem
# No trailing slash, same reason as node_modules: sealed logs are big enough to
# want to park on an external disk and symlink back.
ride-logs
*.celog

# VCU parameter snapshots written by service mode (src/vcu/sweep.ts). Generated output,
# and specific to one motorcycle — the name table it is read against IS committed
# (src/vcu/param-table.ts), so another owner gets everything they need to take their
# own. Committing one deliberately, as a reference set of real Eva Ribelle values,
# would be a fine thing to do; it just should not happen by accident on every run.
vcu-params

