engine-strict=true

# Same policy as the repo root's .npmrc, repeated because a nested .npmrc REPLACES it rather
# than merging with it: `npm --prefix map` reads this file as its project config and never sees
# the root's. Without the line below, npm 12 and newer install better-sqlite3 with no
# build/Release/better_sqlite3.node and the server routes die on require() — the same failure
# docs/pi-install-prerequisites.md describes for the service. npm 11 warns that the key is
# unknown and runs the scripts anyway, which is why this is invisible until the version bump.
#
# Only better-sqlite3 here: the Pi's three native packages are not dependencies of this viewer,
# which never runs on the Pi.
#
# ⚠️ COMMITTED to a public repo. No registry URL, no _authToken — those belong in ~/.npmrc.
allow-scripts=better-sqlite3
